/build/
/.direnv/
/node_modules/
/dist/
__pycache__/
*.pyc
# Claude Code project MCP config — machine-local (copy .mcp.json.example)
/.mcp.json
# Claude Code local state (per-machine settings, worktrees) — except the shipped skills
/.claude/*
!/.claude/skills/

# local MC mapping cache (srg.py) + decompiled sources — large, regenerable
mappings/
decompiled/
harness/srg_names.json

# parkour_exp.py experiment artifacts (trace.json/svg/mp4)
out/

# Multi-bot fleet registry — host-specific (instance paths/ports), regenerated by sync.py
/mc-bots.json
/mc-tasks.json

# machine-local config (instances root etc.) — copy local.config.json.example
/local.config.json

# OPTIONAL fork/user build-time config override (deep-partial ConfigOverrides, baked into the
# bundle by tsup) — per-fork tuning, not shared; absent → build unchanged
/config/local.overrides.json

# release prep working files (demo scenario, post drafts) — never published
/release/
/site/
