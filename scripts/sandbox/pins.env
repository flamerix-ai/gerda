# pins.env — what the sandbox scripts download themselves: version, URL, sha256 (the base
# image: digest). Sourced by sbx.sh (inside the container) and by `provision.sh build`. Every
# sha256 must be set (64 hex digits, tagged gate:pins-set): fetch() refuses a download
# without one.
# Checked elsewhere, or not by us:
#   - the mod files of the Monifactory client pack, which the launcher's own import downloads
#     (or `client --from` copies): one sha256 per file in monifactory-0.13.4-client-files.tsv
#     (projectID, fileID, file name, sha256);
#   - the vanilla server jars that generate the matrix worlds: the sha1 that Mojang's version
#     manifest publishes, read at run time;
#   - what the launcher downloads by itself (Minecraft, loaders, libraries, assets, Java): the
#     launcher checks those, these scripts do not;
#   - the Ubuntu packages of the image: apt checks them against Ubuntu's signed archive; their
#     versions are the ones current on the day of the build, not pinned;
#   - your own modpack (`pack`): the zip by the sha256 you pass; its mod files are recorded
#     with their sha256 (~/.sbx/pack-<instance>-files.tsv), not pinned.

# --- dedicated server (docs/SERVER_SETUP.md) ---
MONI_VERSION=0.13.4
SERVER_ZIP_URL="https://github.com/Omicron-Industries/Monifactory/releases/download/${MONI_VERSION}/Monifactory-Beta.${MONI_VERSION}-server.zip"
SERVER_ZIP_SHA256="15cb432cae2d79fc5052e03aaa55a52dc59b251bfb17e6ae9fe965f789051f49"   # gate:pins-set
FORGE_VERSION=1.20.1-47.4.13
FORGE_INSTALLER_URL="https://maven.minecraftforge.net/net/minecraftforge/forge/${FORGE_VERSION}/forge-${FORGE_VERSION}-installer.jar"
FORGE_INSTALLER_SHA256="cce3c47e532ab19442435ad8c817ef4c9a76ea1cde9802fcdeb9bff9e39e8289"   # gate:pins-set
# monilabs 0.21.2 (shipped by the 0.13.4 packs) crashes the dedicated server; both sides get 0.21.7.
MONILABS_URL="https://github.com/NegaNote/MoniLabs/releases/download/1.20.1-0.21.7/monilabs-0.21.7.jar"
MONILABS_SHA256="76029e5c4c336d71e454f323000a926a1a31d597820658220221a2a7589119d3"   # gate:pins-set
MONILABS_OLD_JAR="monilabs-0.21.2.jar"

