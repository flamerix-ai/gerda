# --- the image (provision.sh build passes these to the Containerfile as build args) ---
# ubuntu:24.04, the multi-arch index digest (its amd64 manifest: sha256:52df9b1e…).
BASE_IMAGE="docker.io/library/ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90"
# sha256 of the x86_64 release archives on GitHub (bun-linux-x64.zip, uv-x86_64-unknown-linux-gnu.tar.gz),
# equal to the checksums each project publishes next to them.
BUN_VERSION=1.4.3
BUN_SHA256="3e730528d89775f03f87f05c06787c4df4099d0a37f3f252e7b829cb23816e18"   # gate:pins-set
UV_VERSION=0.13.1
UV_SHA256="eadd9d27c134ab5ac1ffd4473b97a741407f3ea238288f03121fc4deddf90220"   # gate:pins-set
